# Domain, unter der Vectra erreichbar ist (DNS muss auf diesen Server zeigen).
VECTRA_DOMAIN=vectra.example.org
# Starkes Datenbankpasswort, z. B. mit: openssl rand -base64 32
POSTGRES_PASSWORD=
# Optional: festes Einmal-Token für die Ersteinrichtung; leer = wird beim ersten Start ins Log geschrieben.
VECTRA_SETUP_TOKEN=
# Optional: bestimmte Version statt latest, z. B. ghcr.io/sh1su/vector:1.0.0 oder :sha-e809aeb
VECTRA_IMAGE=ghcr.io/sh1su/vector:latest
# Optional: maximale Dateigröße für Uploads in MB (Default 25).
# VECTRA_MAX_UPLOAD_MB=25

# Optional: KI-Assistent mit Claude (Anthropic). Leer = Assistent aus; der MCP-Server für
# externe KI-Clients (API-Token) funktioniert auch ohne. Schlüssel: https://console.anthropic.com
# VECTRA_ASSISTANT_PROVIDER=anthropic
# VECTRA_ASSISTANT_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# Websuche für Herstellerangaben (Wartungspläne), Default true:
# VECTRA_ASSISTANT_WEB_SEARCH=true
