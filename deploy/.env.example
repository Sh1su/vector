# Domain, unter der Vectra erreichbar ist (DNS muss auf diesen Server zeigen).
VECTRA_DOMAIN=vectra.example.org
# Starkes Datenbankpasswort, z. B. mit: openssl rand -base64 32
POSTGRES_PASSWORD=
# Optional: festes Einmal-Token für die Ersteinrichtung; leer = wird beim ersten Start ins Log geschrieben.
VECTRA_SETUP_TOKEN=
# Optional: bestimmte Version statt latest, z. B. ghcr.io/sh1su/vector:1.0.0 oder :sha-e809aeb
VECTRA_IMAGE=ghcr.io/sh1su/vector:latest

# --- Optional: KI-Assistent (ADR-024). Leer lassen = Assistent aus. ---
# Claude (Anthropic, externer Dienst): Provider anthropic + API-Schlüssel; Modell leer = claude-opus-5-5
# Lokal mit Ollama: Provider ollama + Modell, z. B. qwen2.5:14b (Ollama-Container separat betreiben)
VECTRA_ASSISTANT_PROVIDER=
VECTRA_ASSISTANT_MODEL=
VECTRA_ASSISTANT_API_KEY=
# Nur bei openai_compatible/ollama: Adresse der Schnittstelle, z. B. http://ollama:11434/v1
VECTRA_ASSISTANT_BASE_URL=
# true = Daten verlassen den Server (Zustimmung je Nutzer nötig); bei ollama Standard false
VECTRA_ASSISTANT_EXTERNAL=
VECTRA_ASSISTANT_NAME=
